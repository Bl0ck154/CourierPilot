<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CourierPilotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CourierPilot"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".CourierPilotDashboardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CourierPilotComposeActivity"
            android:exported="false" />

        <activity
            android:name=".CourierPilotHomeActivity"
            android:exported="false" />

        <activity
            android:name=".CourierPilotActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".OfferDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".AddressDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ReliabilityActivity"
            android:exported="false" />

        <activity
            android:name=".RouteResearchActivity"
            android:exported="false" />

        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".CourierPilotNotificationListener"
            android:exported="false"
            android:label="CourierPilot notification access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".OfferAccessibilityService"
            android:exported="false"
            android:label="CourierPilot screen capture"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".BoltAccessibilityDiagnosticsService"
            android:exported="false"
            android:label="CourierPilot Bolt diagnostics"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bolt_diagnostics_accessibility_service_config" />
        </service>

    </application>
</manifest>